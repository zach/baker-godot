<Project Sdk="Microsoft.NET.Sdk">
  <!-- Baker for Godot's C# API, as the NuGet package Baker.Godot: typed calls over the
       Baker autoload, which the addon (addons/baker, the native extension) provides. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>BakerGodot</RootNamespace>
    <PackageId>Baker.Godot</PackageId>
    <Version>0.3.0-dev</Version>
    <Authors>Zach Baker</Authors>
    <Description>Baker's layered tuning data in a Godot 4.7 C# game: typed reads, layers, live edits, rules, records and lockstep, over the Baker for Godot addon.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/zach/baker-godot</RepositoryUrl>
    <PackageTags>godot;baker;tuning;data;gamedev</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The game's own Godot.NET.Sdk brings GodotSharp; this only compiles against it. -->
    <PackageReference Include="GodotSharp" Version="4.7.2" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
