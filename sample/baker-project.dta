; The layer stack the game and every tool open: bottom to top.
(project
   (layers
      (default "data/tuning.dta")
      ; Each plugin's pack: plugins/NAME/layer.dta, a layer named NAME (or a .dta file there).
      (plugins (dir "plugins") optional)
      ; A dedicated server's values: in the stack only where the build defines `server`.
      (server "data/server.dta" (when server))
      ; Your own tuning, kept out of version control in Godot's user:// directory.
      ; dev_only: an export leaves it out, and a shipping build never reads it.
      (local "user://baker/local.dta" optional dev_only)
      ; What an agent tunes, for review: never shipped until a person promotes it.
      (agent "data/agent.dta" optional dev_only)
      ; Experiments: toggled while playing (F1).
      (floaty "data/experiments/floaty.dta" disabled)
      ; A rule, not a number: armor stops half as much (the skirmish's damage).
      (piercing "data/experiments/piercing.dta" disabled))
   ; What --baker sim runs, and what judges each run (sim/driver.gd gives the player's
   ; functions they call).
   (scenarios "sim/scenarios")            ; a directory: one .dta file a scenario
   (objectives "sim/objectives.dta"))
