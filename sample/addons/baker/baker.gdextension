[configuration]

entry_symbol = "baker_godot_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/baker/bin/libbaker_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/baker/bin/libbaker_godot.linux.template_release.x86_64.so"
linux.editor.x86_64 = "res://addons/baker/bin/libbaker_godot.linux.editor.x86_64.so"
windows.debug.x86_64 = "res://addons/baker/bin/libbaker_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/baker/bin/libbaker_godot.windows.template_release.x86_64.dll"
windows.editor.x86_64 = "res://addons/baker/bin/libbaker_godot.windows.editor.x86_64.dll"
