; What judges a scenario's run. Each measures a number from the game ({player.apex}: how
; high the last jump rose above its takeoff, sim/driver.gd), then passes if its test of
; $value is nonzero.

(objective jump.apex (desc "Within 2 px of the data's jump height")
   (measure {player.apex})
   (pass {and {>= $value {- {config.get player.jump.height} 2}}
              {<= $value {+ {config.get player.jump.height} 2}}}))

(objective reach.first_platform (desc "Clears the first platform, 100 px up, by 10 px")
   (measure {player.apex})
   (pass {>= $value 110}))

(objective reach.not_second_platform (desc "Stays 20 px below the second platform, 180 px up")
   (measure {player.apex})
   (pass {<= $value 160}))

(objective duel.tank_holds (desc "Infantry takes at least 3 hits to destroy a tank")
   (measure {skirmish.hits infantry tank 0})
   (pass {>= $value 3}))

(objective cards.fireball_cost (desc "Fireball costs what the data says, not its file's 3")
   (measure {skirmish.card fireball cost})
   (pass {== $value 2}))

(objective cards.strike_upgrades (desc "Strike upgrades to bash, a card named in the data")
   (measure {== {skirmish.card strike upgrade} bash})
   (pass $value))

(objective match.turn_seconds (desc "A turn's time limit: 30 on a server build, else none")
   (measure {config.get match.turn_seconds})
   (pass {or {== $value 0} {== $value 30}}))

(objective economy.tank_by_turn_5 (desc "The opening's tank is built by turn 5")
   (measure {skirmish.built_at tank})
   (pass {<= $value 5}))

(objective economy.army_by_turn_10 (desc "Blue's army is ready by turn 10")
   (measure {if {== $ended army_ready} $steps 99})
   (pass {<= $value 10}))
