{
  "schema": "baker-godot.bridge/1",
  "game": "Baker Platformer",
  "about": "How an agent bridge (baker-mcp's, planned) drives this game. Each command is an argument list, run in this file's directory; {godot} is the Godot 4.5 binary ($GODOT, else godot on PATH), {port} a free loopback port, {out} a file or directory the bridge reads. Godot prints its banner on stdout first: read results from {out}.",
  "project": "baker-project.dta",
  "tool": {
    "command": ["{godot}", "--headless", "--path", ".", "--", "--baker"],
    "out": ["--out", "{out}"],
    "commands": {
      "check": ["check", "--json"],
      "vocabulary": ["reference", "--json"],
      "eval": ["eval", "--json"],
      "diff": ["diff"],
      "promote_preview": ["promote", "--to", "default", "--patch", "{out}"]
    },
    "schemas": {
      "check": "baker.check/1",
      "vocabulary": "{reference: baker.reference/1, tweaks: baker.tweaks/1, shapes: baker.shapes/1}",
      "eval": "one baker.reply/1.1 line per command"
    }
  },
  "sim": {
    "command": ["{godot}", "--headless", "--path", ".", "--"],
    "scenario": ["--scenario", "{name}"],
    "out": ["--out", "{out}"],
    "results": "{out}/results.json",
    "schema": "stacks.sim/1.1",
    "scenarios": ["jump", "reach"]
  },
  "console": {
    "command": ["{godot}", "--headless", "--path", ".", "--", "--console-port", "{port}"],
    "allow_write": ["--console-write"],
    "address": "127.0.0.1:{port}",
    "protocol": "a line (ID {command}) is answered with one line of baker.reply/1.1 JSON, then an empty line"
  },
  "layers": {
    "agent": "data/agent.dta",
    "promote_to": "default",
    "left_out_of_runs": ["local"]
  }
}
